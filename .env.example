# Backend Configuration
# SQLAlchemy database URI (PostgreSQL recommended for production)
# Example: postgresql://user:password@localhost/turia_db
DATABASE_URL=sqlite:///turia_practice.db

# JWT Security
JWT_SECRET_KEY=generate-a-secure-key-here

# Email (Gmail SMTP)
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# CORS Settings
CORS_ORIGIN=http://localhost:5173

# Frontend Configuration (for reference)
# VITE_API_URL=http://localhost:5005/api
